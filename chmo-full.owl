        <oboInOwl:hasExactSynonym>SHE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>normal hydrogen electrode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>standard H2 electrode</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>standard hydrogen electrode</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002348</oboInOwl:id>
        <rdfs:label>hydrogen gas electrode</rdfs:label>
    </owl:Class>
