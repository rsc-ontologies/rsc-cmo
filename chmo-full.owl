    <!-- http://purl.obolibrary.org/obo/CHMO_0002619 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002619">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002282"/>
        <obo:IAO_0000115>An image obtained by scanning the specimen with a finely focused (&lt;10 nm diameter) electron beam under vacuum and measuring the intensities of the transmitted electrons. The beam of electrons is scattered or diffracted at high angles before reaching the specimen, and the image results from a weakening of the beam by its interaction with the sample. An annular aperture is used to select electrons that have passed through given symmetric zones within the objective lens of the microscope.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-11-24T04:00:55Z</oboInOwl:creation_date>
