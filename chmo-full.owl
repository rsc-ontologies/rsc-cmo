    <!-- http://purl.obolibrary.org/obo/CHMO_0001899 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001899">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001904"/>
        <obo:IAO_0000115>An experimental method where the sample is first transferred to the liquid phase using a supercritical fluid, then subjected to column chromatography where the supercritical fluid acts as the mobile phase, and finally depressurised, collected and subjected to gas chromatography.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-06-02T11:26:37Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>SFE-SFC-GC</oboInOwl:hasExactSynonym>
