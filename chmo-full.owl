    <!-- http://purl.obolibrary.org/obo/CHMO_0000032 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000032">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000024"/>
        <obo:IAO_0000115>A voltammetry in which &quot;the working electrode is a dropping mercury (or other liquid conductor) electrode and unstirred solutions are used&quot;.</obo:IAO_0000115>
