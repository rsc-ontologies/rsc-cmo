        <oboInOwl:hasExactSynonym>Loeb-Sourirajan technique</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dry-wet phase inversion technique</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002215</oboInOwl:id>
        <rdfs:label>dry-wet phase inversion technique</rdfs:label>
    </owl:Class>
