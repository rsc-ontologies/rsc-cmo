    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001576">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002208"/>
        <obo:IAO_0000115>The removal of solvent from a sample by applying heat and lowering the pressure above the sample whilst rotating it at 10–300 rpm.</obo:IAO_0000115>
