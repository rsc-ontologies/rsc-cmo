        <owl:annotatedTarget>XFM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0002312 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000067"/>
        <obo:IAO_0000115>An imaging technique where soft X-rays (100–1000 eV) are directed at the specimen, and the difference in absorption of the X-rays by different elements (mainly O and C) produces an image.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-08-26T05:09:56Z</oboInOwl:creation_date>
