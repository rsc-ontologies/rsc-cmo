    <!-- http://purl.obolibrary.org/obo/CHMO_0001846 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001846">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001845"/>
        <obo:IAO_0000115>A composite pulse decoupling sequence designed to remove signal splitting due to heteronuclear J-couplings in multinuclear liquid NMR experiments. Also used to allow transfer of magnetisation between nuclei (by making the spins precess with at the same chemical shift and thus enjoy strong coupling–-isotropic mixing).</obo:IAO_0000115>
        <obo:OMO_0003012>DIPSI</obo:OMO_0003012>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-05-29T12:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>DIPSI pulse sequence</oboInOwl:hasExactSynonym>
