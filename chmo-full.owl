        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001690"/>
        <obo:IAO_0000115>The simultaneous precipitation of a normally soluble component with a polymer component from the same solution by the formation of a composite by adsorption, occlusion or mechanical entrapment.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
