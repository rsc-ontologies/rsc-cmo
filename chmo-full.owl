    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0002456 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002456">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000223"/>
        <obo:IAO_0000115>A method for determining structure where the sample is illuminated with light and the ellipsometric angles of the reflected light are measured from the configuration of the analyzer and the compensator for which no reflected light is detected.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
