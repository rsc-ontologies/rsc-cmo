    <!-- http://purl.obolibrary.org/obo/CHMO_0001988 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001988">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002063"/>
        <obo:IAO_0000115>A method for the synthesis of solid particles from an aerosol. The desired solid particles are suspended in a liquid, which is heated to 275–330 °C under pressure and passed through an orifice so that an aerosol forms. The particles in the aerosol are polymerised by partial evaporation of the solvent.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-06-18T10:08:38Z</oboInOwl:creation_date>
