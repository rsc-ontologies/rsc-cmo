        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000564"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Mass spectrometry where the sample is bombarded with a stream of primary mass-selected particles and the secondary elemental ions (usually H+, D+ or He+) ejected from the sample are detected.</owl:annotatedTarget>
