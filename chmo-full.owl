        <oboInOwl:hasExactSynonym>DSFMA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>DSFMAR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>NC-AFM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>NC-SFM</oboInOwl:hasExactSynonym>
