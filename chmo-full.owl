        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A voltammetry in which the potential is varied as a square wave and the current is measured at the end of each half-wave, just prior to potential change.</owl:annotatedTarget>
