        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An imaging technique where soft X-rays (100–1000 eV) are directed at the specimen, and the difference in absorption of the X-rays by different elements (mainly O and C) produces an image.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:030644433X</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0002313 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002313">
