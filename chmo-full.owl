    <!-- http://purl.obolibrary.org/obo/CHMO_0002225 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002224"/>
