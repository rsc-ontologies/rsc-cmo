    <!-- http://purl.obolibrary.org/obo/CHMO_0000196 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000181"/>
        <obo:IAO_0000115>A method for determining structure by measuring the velocity of neutrons in known magnetic fields before and after scattering by the sample. The neutrons are scattered by the interaction of neutron spin with spins in the sample (&apos;spin echo&apos;).</obo:IAO_0000115>
