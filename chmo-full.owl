    <!-- http://purl.obolibrary.org/obo/CHMO_0002402 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001001"/>
        <obo:IAO_0000115>A column chromatography in which the stationary bed is within a tube and the mobile phase moves continuously through the column and the analyte is detected as it emerges from the column.</obo:IAO_0000115>
