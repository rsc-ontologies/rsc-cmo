    <!-- http://purl.obolibrary.org/obo/CHMO_0000189 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000189">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000188"/>
        <obo:IAO_0000115>A method for determining structure by measuring the change in direction of scattered neutrons. Neutrons are scattered by the atomic nuclei in the sample, phase is not conserved and the neutrons retain all of their kinetic energy during collisions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>EINS</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000189</oboInOwl:id>
