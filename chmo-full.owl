        <oboInOwl:hasExactSynonym>supercritical fluid antisolvent process</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001905</oboInOwl:id>
        <rdfs:label>supercritical antisolvent technique</rdfs:label>
