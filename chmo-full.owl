    <!-- http://purl.obolibrary.org/obo/CHMO_0002801 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002801">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002803"/>
        <obo:IAO_0000115>A figure of merit expressing &quot;the smallest measure, 𝒙L, that can be detected with reasonable certainty for a given analytical procedure.&quot;</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0002801</oboInOwl:id>
        <rdfs:comment>xL = &lt;x&gt; + ks where &lt;x&gt; is the mean of the blank measures, s is the standard deviation and k is a numerical factor chosen according to the desired confidence level.</rdfs:comment>
        <rdfs:label>limit of detection</rdfs:label>
    </owl:Class>
    <owl:Axiom>
