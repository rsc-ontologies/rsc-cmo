    <!-- http://purl.obolibrary.org/obo/CHMO_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000029"/>
