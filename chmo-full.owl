        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A polarography in which the potential is varied using pulses of linearly increasing amplitude (one pulse during each drop lifetime) and the current is sampled after each voltage pulse.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FIX:0000812</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000032"/>
        <obo:IAO_0000115>An *obsolete* electrochemical technique where the cell current is measured as a function of time and as a function of the potential between the indicator and reference electrodes using an oscillograph. The working electrode is a dropping mercury (or other liquid conductor) electrode and unstirred solutions are used.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>oscillo-polography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>oscillopolography</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000038</oboInOwl:id>
        <rdfs:label>oscillo polarography</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000038"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An *obsolete* electrochemical technique where the cell current is measured as a function of time and as a function of the potential between the indicator and reference electrodes using an oscillograph. The working electrode is a dropping mercury (or other liquid conductor) electrode and unstirred solutions are used.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:978-3-540-74597-6</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000032"/>
        <obo:IAO_0000115>A polarography in which the current is sampled only during a specific time interval of the life of each drop of the droppping mercury electrode.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>TAST polarography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sampled DC polarography</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000039</oboInOwl:id>
        <rdfs:label>tast polarography</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000039"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A polarography in which the current is sampled only during a specific time interval of the life of each drop of the droppping mercury electrode.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FIX:0000795</oboInOwl:hasDbXref>
