    <!-- http://purl.obolibrary.org/obo/CHMO_0001524 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001524">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001522"/>
