        <oboInOwl:hasExactSynonym>IP-ICP/MS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>IPC-ICP-MS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>IPC-ICP/MS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ion pairing chromatography-inductively coupled plasma mass spectrometry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ion-pair chromatography inductively coupled plasma mass spectrometry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ion-pair chromatography inductively coupled plasma mass spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ion-pairing chromatography-inductively coupled plasma mass spectrometry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002281</oboInOwl:id>
        <rdfs:label>ion-pair chromatography-inductively coupled plasma mass spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002281"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A method where a sample mixture is first separated by ion-pair chromatography (where sample ions are &apos;paired&apos; or neutralised and separated as an ion pair on a reversed-phase column) before being ionised in a plasma (a partially ionised gas–-such as Ar–-containing free electrons) which has been generated by electromagnetic induction, and characterised according to mass-to-charge ratio and relative abundance.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


