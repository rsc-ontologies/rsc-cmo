        <oboInOwl:hasExactSynonym>diffusion ordered spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>diffusion-edited NMR spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>diffusion-edited spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>diffusion-ordered NMR spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>diffusion-ordered nuclear magnetic resonance spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000733</oboInOwl:id>
        <rdfs:label>diffusion-ordered spectroscopy</rdfs:label>
    </owl:Class>
