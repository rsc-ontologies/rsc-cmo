    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001301"/>
        <obo:IAO_0000115>A synthesis method for growing single crystals from an aqueous solution in an autoclave (a thick-walled steel vessel) at high temperature (400 °C) and pressure.</obo:IAO_0000115>
