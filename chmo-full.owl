    <!-- http://purl.obolibrary.org/obo/CHMO_0000188 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000181"/>
        <obo:IAO_0000115>A method for determining structure by measuring the change in direction or energy of scattered neutrons. Neutrons are scattered by the atomic nuclei in the sample and phase is not conserved.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>INS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHMO:0000188</oboInOwl:id>
        <rdfs:label>incoherent neutron scattering</rdfs:label>
