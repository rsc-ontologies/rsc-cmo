    <!-- http://purl.obolibrary.org/obo/CHMO_0002018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002017"/>
        <obo:IAO_0000115>A method where the components of a sample are separated on the basis of their density, in a density gradient of e.g. CsCl in a centrifuge, according to buoyant density. The species in the sample move through the gradient until they reach a point where their density and that of the gradient are identical.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-06-19T02:20:10Z</oboInOwl:creation_date>
