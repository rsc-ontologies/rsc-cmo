        <oboInOwl:hasExactSynonym>arc-physical vapor deposition</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>arc-physical vapour deposition</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001357</oboInOwl:id>
        <rdfs:label>cathodic arc deposition</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001357"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A synthesis technique where an electric arc is used to vaporize material from a cathode target. The vaporized material then condenses on a substrate, forming a thin film.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001358 -->

