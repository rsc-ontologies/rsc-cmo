                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0400064"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The trapping of microscopic particles by a focused laser beam. The beam is focused through a microscope objective, producing a strong electric field gradient at its narrowest point, which attracts dielectric particles.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-05-20T10:35:42Z</oboInOwl:creation_date>
