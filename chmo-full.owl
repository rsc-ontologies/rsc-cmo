    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000760"/>
        <obo:IAO_0000115>A method for determining the distance between molecules using an energy transfer between two chromophores (a donor and an acceptor) in close proximity (typically &lt;10 nm) via a nonradiative, long-range dipole-dipole coupling mechanism.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>Forster resonant energy transfer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Förster resonance energy transfer</oboInOwl:hasExactSynonym>
        <oboInOwl:hasRelatedSynonym>FRET</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHMO:0000062</oboInOwl:id>
        <rdfs:label>Forster resonance energy transfer</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000062"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
