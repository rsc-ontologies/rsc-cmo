    <!-- http://purl.obolibrary.org/obo/CHMO_0002715 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002715">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000896"/>
        <obo:IAO_0000115>A magic angle spinning NMR experiment in which the evolution of dipolar couplings between 31P and 13C nuclei is controlled by applying pulses at appropriate points in the rotational period, allowing the determination of the size of the coupling and, thus, yielding distance information.</obo:IAO_0000115>
        <oboInOwl:created_by>Hils</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-07-25T05:07:19Z</oboInOwl:creation_date>
