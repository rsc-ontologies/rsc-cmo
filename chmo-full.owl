    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0003547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0600046"/>
        <obo:IAO_0000111>liquid chromatography</obo:IAO_0000111>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000120"/>
