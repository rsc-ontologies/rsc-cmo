    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000401 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000401">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
