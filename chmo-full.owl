        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001505"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The chemical degradation of a sample caused by a fast rate of temperature increase (10,000 K/s).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>OrangeBook:5.3</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001506 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001506">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001502"/>
        <obo:IAO_0000115>The chemical degradation of different fractions of the same sample by heating at different temperatures for different times.</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0001506</oboInOwl:id>
        <rdfs:label>fractionated pyrolysis</rdfs:label>
    </owl:Class>
