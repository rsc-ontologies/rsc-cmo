    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBCS_0000058 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBCS_0000058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBCS_0000220"/>
