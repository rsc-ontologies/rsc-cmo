        <oboInOwl:hasExactSynonym>1D-nOesy</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000724</oboInOwl:id>
        <rdfs:label>one-dimensional nuclear Overhauser enhancement spectroscopy</rdfs:label>
    </owl:Class>
