    <!-- http://purl.obolibrary.org/obo/CHMO_0002006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002008"/>
        <obo:IAO_0000115>A method where the sample is first subjected to column chromatography where the mobile phase is a liquid, the stationary phase consists of very small particles and the inlet pressure is relatively high. The sample passes through two columns (anion and cation exchange) in series. The eluent is then subjected to mass spectrometry where it is ionised in a plasma which has been generated by electromagnetic induction.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-06-19T01:34:38Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>tandem dual-column HPLC-ICP-MS</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002006</oboInOwl:id>
        <rdfs:label>tandem dual-column high-performance liquid chromatography inductively coupled plasma mass spectrometry</rdfs:label>
    </owl:Class>
