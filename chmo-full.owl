        <oboInOwl:hasDbXref>http://www.microscopyu.com/articles/fluorescence/fluorescenceintro.html</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0001-5985-7429</oboInOwl:hasDbXref>
