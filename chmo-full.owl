        <oboInOwl:hasExactSynonym>silicon-29 cross-polarization magic angle spinning nuclear magnetic resonance spectra</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>silicon-29 cross-polarization magic angle spinning nuclear magnetic resonance spectrum</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002505</oboInOwl:id>
        <rdfs:label>silicon-29 cross-polarisation magic angle spinning nuclear magnetic resonance spectrum</rdfs:label>
