    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002335">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001658"/>
        <obo:IAO_0000115>An ionisation method in which the sample (usually a large organic molecule or biomolecule) is vaporised and ionised using a high-energy pulsed laser.</obo:IAO_0000115>
