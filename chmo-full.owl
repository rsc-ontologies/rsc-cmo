    <!-- http://purl.obolibrary.org/obo/CHMO_0000181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000160"/>
        <obo:IAO_0000115>A scattering method for determining structure by measuring the change in direction or energy of scattered neutrons. Neutrons are scattered by the atomic nuclei in the sample and the intensity of the scattering is given by the scattering vector Q = (4/)sin(pi/2).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>FIX:0000400</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>neutron scattering analysis</oboInOwl:hasExactSynonym>
