        <oboInOwl:hasExactSynonym>high resolution diffusion-ordered spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>high-resolution DOSY</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000790</oboInOwl:id>
        <rdfs:label>high-resolution diffusion-ordered spectroscopy</rdfs:label>
    </owl:Class>
