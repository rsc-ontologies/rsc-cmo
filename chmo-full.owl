    <!-- http://purl.obolibrary.org/obo/CHMO_0001157 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000638"/>
        <obo:IAO_0000115>A technique for measuring the time-resolved concentration of monomers during polymerisation reactions. The polymerisation is initiated by a single pulse of laser radiation and the monomer concentration is monitored by measuring absorbance in the near-infrared (0.8–2 μm) region.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-03-13T11:42:53Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>SP-PLP-NIR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>single pulse-pulsed laser polymerization-near-infrared</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001157</oboInOwl:id>
        <rdfs:label>single pulse–pulsed laser polymerization–near-infrared technique</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001157"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A technique for measuring the time-resolved concentration of monomers during polymerisation reactions. The polymerisation is initiated by a single pulse of laser radiation and the monomer concentration is monitored by measuring absorbance in the near-infrared (0.8–2 μm) region.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:386727682X</oboInOwl:hasDbXref>
    </owl:Axiom>
    


