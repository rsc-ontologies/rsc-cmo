    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001511">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001502"/>
        <obo:IAO_0000115>The chemical degradation of a sample by thermal energy in which the products of a reaction are trapped before analysis.</obo:IAO_0000115>
