        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001844"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An NMR pulse sequence that decouples nuclei i.e. removes the effects of (usually) J-coupling (line splitting) from the spectrum.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>rsc:pr</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001845 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001845">
