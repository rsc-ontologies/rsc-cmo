        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Sputter deposition where a secondary ion beam is then used to remove any partially bound atoms from the substrate surface.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001367 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001367">
