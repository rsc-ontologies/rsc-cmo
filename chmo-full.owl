        <oboInOwl:hasExactSynonym>3D-COSY-NOESY</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>3D-COSY–NOESY</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>COSY-NOESY</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>COSY–NOESY</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002735</oboInOwl:id>
        <rdfs:label>correlation spectroscopy-nuclear Overhauser enhancement spectroscopy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002735"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of homonuclear three-dimensional NMR experiment in which a second frequency dimension is employed to disperse the signals and reveal correlations between nuclei which are J-coupled (usually \leq 3 bonds apart). These signals are then correlated to nuclei that are spatially proximate within the molecule (\leq 6 \AA apart).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FIX:0000190</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
