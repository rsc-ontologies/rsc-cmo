        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Microscopy in which the same object (e.g., a cell) is imaged at regular time intervals over several hours.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001075">
