    <!-- http://purl.obolibrary.org/obo/CHMO_0000953 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000953">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000968"/>
        <obo:IAO_0000115>A piece of apparatus which is used to generate an image of the surface of a specimen, whether by focusing reflected light onto where it can be collected or by scanning a given area of the surface.</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0000953</oboInOwl:id>
        <rdfs:label>microscope</rdfs:label>
