        <oboInOwl:hasExactSynonym>125Te-NMR</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001081</oboInOwl:id>
        <rdfs:label>125Te nuclear magnetic resonance spectroscopy</rdfs:label>
