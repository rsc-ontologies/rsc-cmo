                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A method where a liquid sample is first separated by capillary electrophoresis, then vaporised and atomised using a probe which is rapidly heated by passing a current through it. The sample is then analysed by illuminating it with ultraviolet or visible light which is absorbed by the non-excited atoms at characteristic wavelengths.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CE-ETAAS</oboInOwl:hasExactSynonym>
