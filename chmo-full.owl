    <!-- http://purl.obolibrary.org/obo/CHMO_0000184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000181"/>
        <obo:IAO_0000115>A method for determining structure by measuring the change in direction or energy of scattered neutrons at small angles (corresponding to a scattering vector Q = (4/)sin(\pi/2) = 0.005–0.2 inverse degrees).</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>FIX:0000253</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>SANS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>low-Q neutron scattering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>small angle neutron scattering</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000184</oboInOwl:id>
        <rdfs:label>small-angle neutron scattering</rdfs:label>
    </owl:Class>
