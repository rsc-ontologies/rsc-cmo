    <!-- http://purl.obolibrary.org/obo/CHMO_0001009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002318"/>
        <obo:IAO_0000115>A liquid–solid chromatography in which the stationary phase consists of very small particles and the inlet pressure is relatively high.</obo:IAO_0000115>
        <obo:OMO_0003012>HPLC</obo:OMO_0003012>
        <oboInOwl:hasAlternativeId>FIX:0000630</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>HPLC Assay</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>high performance liquid chromatography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>high pressure liquid chromatography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>high-performance liquid chromatography assay</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>high-pressure liquid chromatography</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001009</oboInOwl:id>
        <rdfs:label>high-performance liquid chromatography</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A liquid–solid chromatography in which the stationary phase consists of very small particles and the inlet pressure is relatively high.</owl:annotatedTarget>
        <prov:hadPrimarySource rdf:resource="https://doi.org/10.1351/goldbook.14142"/>
    </owl:Axiom>
