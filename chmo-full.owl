    <!-- http://purl.obolibrary.org/obo/CHMO_0002712 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002712">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000003"/>
        <obo:IAO_0000115>A technique that operates by mechanically vibrating a probe at a fixed amplitude, frequency and height over an electrochemically active sample in solution measuring and mapping the electric field generated by the sample. This technique is used to probe the nature of corrosion processes.</obo:IAO_0000115>
        <oboInOwl:created_by>Hils</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-07-25T04:28:54Z</oboInOwl:creation_date>
