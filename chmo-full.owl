    <!-- http://purl.obolibrary.org/obo/CHMO_0002448 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002448">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002445"/>
        <obo:IAO_0000115>Spectroscopy where the sample is illuminated with an initial laser pulse (the &apos;pump&apos;) which causes excitations within the sample. This is followed by a second laser pulse which is tuned to the correct frequency to excite transitions resonantly back down to the lower electronic state (the &apos;dump&apos;). After a short delay a third laser pulse (the &apos;probe&apos;) is used to sense changes in the sample.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-09-23T03:18:56Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>PDP spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pump-dump-probe (PDP) spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pump-dump-probe spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pump–dump–probe (PDP) spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002448</oboInOwl:id>
        <rdfs:label>pump–dump–probe spectroscopy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002448"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
