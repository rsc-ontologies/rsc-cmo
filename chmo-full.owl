    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002204"/>
        <obo:IAO_0000115>A process for forming thermoplastic polymer samples by dipping a mould into a solution of the polymer and particles of known dimension, and drawing off the solvent to leave a composite polymer-particle film adhering to the mould.</obo:IAO_0000115>
