    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000049">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000185"/>
        <obo:IAO_0000115>The simultaneous measurement of spectra and images. A radiation source illuminates the sample and a series of spatially resolved spectra are collected.</obo:IAO_0000115>
