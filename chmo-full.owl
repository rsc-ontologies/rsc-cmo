    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002084"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The measurement of thermodynamic parameters (e.g. enthalpy) during a chemical or biochemical reaction of both a sample and a reference, by the known variation (step-wise or linear) of temperature whilst a second variable is kept constant. The power input is in the form of a sine wave.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0803128878</oboInOwl:hasDbXref>
    </owl:Axiom>
    


