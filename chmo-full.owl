        <oboInOwl:hasExactSynonym>31P-NMR</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000739</oboInOwl:id>
        <rdfs:label>31P nuclear magnetic resonance spectroscopy</rdfs:label>
    </owl:Class>
