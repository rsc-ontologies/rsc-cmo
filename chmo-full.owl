        <oboInOwl:hasDbXref>OrangeBook:8.3</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0002348 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002348">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002345"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002347"/>
        <obo:IAO_0000115>A reference gas electrode based on the equilibrium between aqueous protons and electrons on one side and hydrogen gas on the other, in solutions saturated with hydrogen gas. Typically it is made of &quot;a thin foil of platinum electrolytically coated with a finely divided deposit of platinum or palladium metal&quot;.</obo:IAO_0000115>
        <oboInOwl:created_by>batchelorc</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-09-11T11:04:46Z</oboInOwl:creation_date>
