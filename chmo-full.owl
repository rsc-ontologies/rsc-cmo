    <!-- http://purl.obolibrary.org/obo/CHMO_0001062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001060"/>
        <obo:IAO_0000115>An electron multiplier that consists of a single electrode in the form of a horn of plenty. The ions impinge on the wall of the horn at the open end, producing a cascade of electrons which is multiplied on each interaction with the wall and focussed onto a preamplifier.</obo:IAO_0000115>
