        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A selective or shaped pulse, which is designed to excite only a specific region of a spectrum.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>rsc:pr</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001871 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001871">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001870"/>
        <obo:IAO_0000115>An adiabatic shaped pulse. The resonance frequency is swept through a defined rf range during application of the pulse. Allows excitation of a broader range of frequencies than the size of the rf field. For the pulse see J. Magn. Reson., Ser. A, (1993), 102, pg 293.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-05-29T12:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>CHIRP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>CHIRP pulse</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>chirp pulse</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001871</oboInOwl:id>
        <rdfs:label>chirped pulse</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001871"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An adiabatic shaped pulse. The resonance frequency is swept through a defined rf range during application of the pulse. Allows excitation of a broader range of frequencies than the size of the rf field. For the pulse see J. Magn. Reson., Ser. A, (1993), 102, pg 293.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>rsc:pr</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001872 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001872">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001870"/>
        <obo:IAO_0000115>An adiabatic shaped pulse incorporating a linear sweep through a frequency range used for selective inversion of spin state populations over wide ranges. For the pulse see J. Magn. Reson., Ser. A, (1995), 115, pg 273.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-05-29T12:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>WURST</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>WURST pulse</oboInOwl:hasExactSynonym>
