        <oboInOwl:hasExactSynonym>statistical COSY</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002545</oboInOwl:id>
        <rdfs:label>statistical total correlation spectroscopy</rdfs:label>
    </owl:Class>
