        <oboInOwl:hasExactSynonym>laser electric resonance spectrometry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000443</oboInOwl:id>
        <rdfs:label>laser electric resonance spectroscopy</rdfs:label>
    </owl:Class>
