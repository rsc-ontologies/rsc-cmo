        <oboInOwl:hasExactSynonym>rotating field mass spectrometry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001785</oboInOwl:id>
        <rdfs:label>rotating-field mass spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001785"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
