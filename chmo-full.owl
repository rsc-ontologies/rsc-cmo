    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001791"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Mass spectrometry where a solid sample is vaporised by depositing it on a probe which is rapidly heated (to &lt;1000 °C) by passing a current through it. The vaporised sample is ionised in a plasma (a partially ionised gas–-such as Ar–-containing free electrons) which has been generated by electromagnetic induction.</owl:annotatedTarget>
