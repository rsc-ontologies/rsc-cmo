        <oboInOwl:hasExactSynonym>weak-beam dark-field (WBDF) electron microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002614</oboInOwl:id>
        <rdfs:label>weak-beam dark-field electron microscopy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002614"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Microscopy where the specimen is bombarded with a finely focused (&lt;10 nm diameter) electron beam with an acceleration voltage 50–150 kV under vacuum. The interaction of the electrons with the specimen produces transmitted, secondary, backscattered and diffracted electrons and characteristic X-rays which are detected. A diffracted beam harmonic  (a &apos;weak beam&apos;) is used rather than the diffracted beam itself, allowing much higher resolution to be obtained.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1039/b9nr00287a</oboInOwl:hasDbXref>
