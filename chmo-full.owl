    <!-- http://purl.obolibrary.org/obo/CHMO_0002597 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002597">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000080"/>
        <obo:IAO_0000115>Microscopy where an electron-transparent specimen, that has been stained with heavy metals salts (e.g. uranyl acetate), is bombarded with a finely focused (&lt;10 nm diameter) electron beam with an acceleration voltage 50–150 kV under vacuum and the intensities of the transmitted electrons are measured.</obo:IAO_0000115>
