        <owl:annotatedTarget>TAST polarography</owl:annotatedTarget>
        <dcterms:source rdf:resource="https://doi.org/10.1351/goldbook.09145"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000039"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>sampled DC polarography</owl:annotatedTarget>
        <dcterms:source rdf:resource="https://doi.org/10.1351/goldbook.09145"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000024"/>
        <obo:IAO_0000115>A voltammetry in which the potential is varied as a square wave and the current is measured at the end of each half-wave, just prior to potential change.</obo:IAO_0000115>
        <obo:OMO_0003012>SWV</obo:OMO_0003012>
