    <!-- http://purl.obolibrary.org/obo/CHMO_0002206 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001688"/>
        <obo:IAO_0000115>A technique used to isolate and purify polymers. The polymer sample is dissolved in a &apos;good&apos; organic solvent, and this solution is then poured into a &apos;poor&apos; solvent . Introduction of the polymer to the poor solvent causes the polymer chains to collapse, aggregate and come out of solution.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-07-24T02:15:51Z</oboInOwl:creation_date>
        <oboInOwl:id>CHMO:0002206</oboInOwl:id>
        <rdfs:label>polymer precipitation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002206"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A technique used to isolate and purify polymers. The polymer sample is dissolved in a &apos;good&apos; organic solvent, and this solution is then poured into a &apos;poor&apos; solvent . Introduction of the polymer to the poor solvent causes the polymer chains to collapse, aggregate and come out of solution.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0873552210</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0002207 -->

