        <prov:hadPrimarySource rdf:resource="https://doi.org/10.1351/goldbook.P04593"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001482"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>photo-curing</owl:annotatedTarget>
        <dcterms:source rdf:resource="https://doi.org/10.1351/goldbook.P04593"/>
    </owl:Axiom>
    


