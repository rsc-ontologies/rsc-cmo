        <oboInOwl:hasExactSynonym>pulsed field gradient spin-echo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pulsed field gradient-spin echo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pulsed field-gradient spin echo</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>pulsed-field-gradient spin-echo NMR spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001118</oboInOwl:id>
        <rdfs:label>pulsed field-gradient spin echo nuclear magnetic resonance spectroscopy</rdfs:label>
    </owl:Class>
