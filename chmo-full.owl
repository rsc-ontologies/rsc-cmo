    <!-- http://purl.obolibrary.org/obo/CHMO_0002201 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001289"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
