    <!-- http://purl.obolibrary.org/obo/CHMO_0002473 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000968"/>
        <obo:IAO_0000115>A piece of apparatus, consisting of a crucible (made of pyrolytic boron nitride, quartz, tungsten or graphite), heating filaments, a water cooling system, which is used to measure very low vapor pressures by measuring the mass of vapor which escapes when the vessel contains a liquid in equilibrium with its vapor. It is also used as a source evaporator during crystal growth e.g. during molecular-beam epitaxy.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-09-29T06:39:36Z</oboInOwl:creation_date>
        <oboInOwl:id>CHMO:0002473</oboInOwl:id>
        <rdfs:label>Knudsen cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002473"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A piece of apparatus, consisting of a crucible (made of pyrolytic boron nitride, quartz, tungsten or graphite), heating filaments, a water cooling system, which is used to measure very low vapor pressures by measuring the mass of vapor which escapes when the vessel contains a liquid in equilibrium with its vapor. It is also used as a source evaporator during crystal growth e.g. during molecular-beam epitaxy.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
