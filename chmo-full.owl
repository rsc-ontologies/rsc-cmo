                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002933"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000793"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000109"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002933"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A measurement datum that is a specified output of an open circuit voltage potentiometry. It represents the potential difference (voltage) measured between two electrodes in a circuit where no current is allowed to flow and is typically used to determine the electromotive force (EMF) of an electrochemical cell.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-5985-7429"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1595-3213"/>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-08-26T12:32:56Z</dcterms:created>
        <rdfs:label xml:lang="en">open circuit voltage</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002934"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A measurement datum that is a specified output of an open circuit voltage potentiometry. It represents the potential difference (voltage) measured between two electrodes in a circuit where no current is allowed to flow and is typically used to determine the electromotive force (EMF) of an electrochemical cell.</owl:annotatedTarget>
        <dcterms:source rdf:resource="https://doi.org/10.1016/j.jpowsour.2014.06.152"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0002935 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002935">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000003"/>
        <obo:IAO_0000115 xml:lang="en">An electrochemical analysis in which a constant current is applied to an electrochemical system while monitoring the resulting potential changes over time. This method is used to study charge storage, reaction kinetics, and material stability by maintaining a fixed current flow and observing the system’s electrochemical response.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/rsc-ontologies/rsc-cmo/issues/37"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1595-3213"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-4378-6061"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0008-1636-0875"/>
        <oboInOwl:id>CHMO:0002935</oboInOwl:id>
        <rdfs:label xml:lang="en">galvanostatic analysis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0002936 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002936">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002935"/>
        <obo:IAO_0000112>As an electrochemical technique for measuring and characterizing batteries and E-chem cells.</obo:IAO_0000112>
        <obo:IAO_0000115>A galvanostatic analysis in which the constant current is reversed or stopped when predefined upper or lower potential limits are reached. This method is commonly used to evaluate charge storage capacity, cycling stability, and electrochemical performance of batteries, supercapacitors, and other energy storage devices.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/rsc-ontologies/rsc-cmo/issues/38"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1595-3213"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-4378-6061"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0008-1636-0875"/>
        <oboInOwl:hasExactSynonym>GCPL</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002936</oboInOwl:id>
        <rdfs:label>galvanostatic cycling with potential limitation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002936"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A galvanostatic analysis in which the constant current is reversed or stopped when predefined upper or lower potential limits are reached. This method is commonly used to evaluate charge storage capacity, cycling stability, and electrochemical performance of batteries, supercapacitors, and other energy storage devices.</owl:annotatedTarget>
        <dcterms:source>https://doi.org/10.1016/j.jelechem.2019.05.052</dcterms:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0002937 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002937">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000016"/>
        <obo:IAO_0000112>As an electrochemical technique for measuring and characterizing batteries and E-chem cells.</obo:IAO_0000112>
        <obo:IAO_0000115>A potentiometry where the change in impedance of an electrochemical cell is measured while maintaining a constant applied potential and the impedance is determined over a range of frequencies by analyzing the voltage-to-current ratio and the phase shift of the AC response.</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/rsc-ontologies/rsc-cmo/issues/36"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1595-3213"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-4378-6061"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0008-1636-0875"/>
        <oboInOwl:hasExactSynonym>PEIS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>impedance spectroscopy with constant applied potential</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>potentiostatic EIS</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002934</oboInOwl:id>
        <rdfs:label>potentiostatic electrochemical impedance spectroscopy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002937"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A potentiometry where the change in impedance of an electrochemical cell is measured while maintaining a constant applied potential and the impedance is determined over a range of frequencies by analyzing the voltage-to-current ratio and the phase shift of the AC response.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1021/acsmeasuresciau.2c00070</oboInOwl:hasDbXref>
    </owl:Axiom>
    


