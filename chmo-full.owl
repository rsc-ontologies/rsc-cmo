        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001502"/>
        <obo:IAO_0000115>The chemical degradation of a sample by thermal energy in the presence of an reductive atmosphere.</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0001514</oboInOwl:id>
        <rdfs:label>reductive pyrolysis</rdfs:label>
    </owl:Class>
