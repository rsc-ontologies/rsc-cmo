        <oboInOwl:hasExactSynonym>laser Doppler anemometry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>laser anemometry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>optical anemometry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002043</oboInOwl:id>
        <rdfs:label>laser Doppler velocimetry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002043"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A method for determining the velocity or zeta-potential of a sample by measuring the Doppler shift experienced by light. A laser beam is directed at a series of fine particles in the medium of interest, and the reflected (or Doppler-shifted) beam then produces an interference pattern with a reference beam.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:047139484X</oboInOwl:hasDbXref>
    </owl:Axiom>
    


