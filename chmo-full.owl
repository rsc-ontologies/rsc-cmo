        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An electrochemical technique where the time dependence of the cell current is measured whilst the potential difference between the indicator and reference electrodes is varied as a step function.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1039/b816223a</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000008 -->

