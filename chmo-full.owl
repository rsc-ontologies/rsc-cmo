    <!-- http://purl.obolibrary.org/obo/CHMO_0002280 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002280">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001001"/>
        <obo:IAO_0000115>A column chromatography in which ions in solution can be &apos;paired&apos; or neutralised and separated as an ion pair on a reversed-phase column. Ion-pairing agents are usually ionic compounds that contain a hydrocarbon chain.</obo:IAO_0000115>
