        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The chemical degradation of different fractions of the same sample by heating at different temperatures for different times.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>OrangeBook:5.3</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001507 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001507">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001502"/>
        <obo:IAO_0000115>A pyrolysis in which &quot;a flowing stream of gas (hydrogen, oxygen, nitrogen, chlorine, etc.) [...] is passed over the [...] sample in a heated furnace&quot;, causing chemical degradation of the sample.</obo:IAO_0000115>
