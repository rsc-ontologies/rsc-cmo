    <!-- http://purl.obolibrary.org/obo/CHMO_0002463 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002463">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001659"/>
        <obo:IAO_0000115>An ionisation method where the sample is either forced through a small heated capillary (at a flow rate of 1–10 L min-1) into an electric field to produce a very fine mist of positively  charged droplets, or solvent droplets subjected to the same process are directed at the sample.</obo:IAO_0000115>
