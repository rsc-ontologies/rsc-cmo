        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001025"/>
        <obo:IAO_0000115>An electrophoresis method where colloidal particles move at different speeds in a separation medium that has an electrophoretic mobility gradient so that the analytes move and stack in the order of their electrophoretic mobilities.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>isotachophoretic focussing</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001046</oboInOwl:id>
        <rdfs:label>isotachophoretic focusing</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001046"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An electrophoresis method where colloidal particles move at different speeds in a separation medium that has an electrophoretic mobility gradient so that the analytes move and stack in the order of their electrophoretic mobilities.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1039/b816717f</oboInOwl:hasDbXref>
    </owl:Axiom>
    


