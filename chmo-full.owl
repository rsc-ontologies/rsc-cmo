        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The chemical degradation of a sample (usually an organic material) by heating it in a vacuum in order to decrease its boiling point and avoid adverse chemical reactions.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001520 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001520">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001500"/>
        <obo:IAO_0000115>A thermal decomposition in which the &quot;uncatalysed cleavage of one or more covalent bonds resulting from exposure of a compound to a raised temperature, or a process in which such cleavage is an essential part.&quot;</obo:IAO_0000115>
