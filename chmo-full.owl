    <!-- http://purl.obolibrary.org/obo/CHMO_0000243 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000234"/>
        <obo:IAO_0000115>An atomic absorption spectroscopy in which the sample is aspirated, aerosolised, and mixed with combustible gases, such as acetylene and air or acetylene and nitrous oxide, and then ignited and atomised in a flame whose temperature ranges from 2100–2800 °C. During combustion, atoms of the element of interest in the sample absorb light at characteristic wavelengths.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>F-AAS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>FAAS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>flame atomic absorption spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000243</oboInOwl:id>
        <rdfs:label>flame atomic absorption spectroscopy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000243"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An atomic absorption spectroscopy in which the sample is aspirated, aerosolised, and mixed with combustible gases, such as acetylene and air or acetylene and nitrous oxide, and then ignited and atomised in a flame whose temperature ranges from 2100–2800 °C. During combustion, atoms of the element of interest in the sample absorb light at characteristic wavelengths.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FIX:0000929</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
