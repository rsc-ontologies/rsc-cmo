        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An electrochemical technique where the cell current is measured whilst the potential difference between the indicator and reference electrodes is held at a constant value (sufficient to oxidize or reduce the sample).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1373/49.10.1763</oboInOwl:hasDbXref>
    </owl:Axiom>
    


