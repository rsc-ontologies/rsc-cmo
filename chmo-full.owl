    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001518">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001502"/>
        <obo:IAO_0000115>The chemical degradation of a sample by thermal energy where the temperature is raised in a stepwise manner and the pyrolysates are recorded between each step.</obo:IAO_0000115>
