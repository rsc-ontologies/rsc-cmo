        <oboInOwl:hasExactSynonym>optical tweezing</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001769</oboInOwl:id>
        <rdfs:label>laser trapping</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001769"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
