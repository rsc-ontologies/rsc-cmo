        <oboInOwl:hasExactSynonym>stir-bar solid phase extraction</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stir-bar sorptive extraction</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001591</oboInOwl:id>
        <rdfs:label>stir-bar solid-phase extraction</rdfs:label>
