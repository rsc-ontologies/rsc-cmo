        <oboInOwl:hasExactSynonym>electron paramagnetic resonance oximetry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>electron paramagnetic resonance spin-label oximetry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>electron paramagnetic resonance spin-probe oximetry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>electron spin resonance spin-label oximetry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>electron spin resonance spin-probe oximetry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spin-label oximetry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>spin-probe oximetry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002110</oboInOwl:id>
        <rdfs:label>electron spin resonance oximetry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
