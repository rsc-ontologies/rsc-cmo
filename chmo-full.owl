    <!-- http://purl.obolibrary.org/obo/CHMO_0001195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000613"/>
        <obo:IAO_0000115>An NMR experiment in which multiple frequencies in an NMR spectrum are excited simultaneously over a broad frequency rnage using polychromatic pulses.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
