        <oboInOwl:id>CHMO:0002725</oboInOwl:id>
        <rdfs:label>single isomorphous replacement</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002725"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A method for providing phasing necessary for X-ray crystallography information by growing a crystal of the sample substituted with heavy metal atoms and analysing the X-ray data for both the original crystal and the isomorph.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FIX:0000246</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0002726 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002724"/>
        <obo:IAO_0000115>A method for providing phasing necessary for X-ray crystallography information by growing a number of crystals of the sample substituted with different heavy metal atoms and analysing the X-ray data for each crystal.</obo:IAO_0000115>
