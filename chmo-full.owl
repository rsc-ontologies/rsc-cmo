    <!-- http://purl.obolibrary.org/obo/CHMO_0002675 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002675">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001288"/>
        <obo:IAO_0000115>A method for generating surface-specific electronic spectra by mixing two light beams at a surface and detecting the output beam, which has frequency equal to the sum of the two input frequencies.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
