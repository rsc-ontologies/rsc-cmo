    <!-- http://purl.obolibrary.org/obo/CHMO_0002640 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002640">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000872"/>
