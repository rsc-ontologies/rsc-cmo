    <!-- http://purl.obolibrary.org/obo/CHMO_0001159 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002834"/>
        <rdfs:subClassOf>
