    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001502"/>
        <obo:IAO_0000115>The chemical degradation of a sample (usually an organic material) by heating it in a vacuum in order to decrease its boiling point and avoid adverse chemical reactions.</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0001519</oboInOwl:id>
        <rdfs:label>vacuum pyrolysis</rdfs:label>
