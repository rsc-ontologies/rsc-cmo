        <obo:IAO_0000119>OBI</obo:IAO_0000119>
        <obo:IAO_0000233>https://github.com/obi-ontology/obi/issues/1685</obo:IAO_0000233>
        <rdfs:label>liquid chromatography</rdfs:label>
    </owl:Class>
    


