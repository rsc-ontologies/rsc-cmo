    <!-- http://purl.obolibrary.org/obo/CHMO_0002633 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002633">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000922"/>
        <obo:IAO_0000115>A plot of cell current vs. the potential between the indicator and reference electrodes obtained from a voltammetry experiment during which convective mass transfer (the movement of material by the action of a fluid) occurs.</obo:IAO_0000115>
