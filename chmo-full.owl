        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001988"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A method for the synthesis of solid particles from an aerosol. The desired solid particles are suspended in a liquid, which is heated to 275–330 °C under pressure and passed through an orifice so that an aerosol forms. The particles in the aerosol are polymerised by partial evaporation of the solvent.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0815515804</oboInOwl:hasDbXref>
    </owl:Axiom>
    


