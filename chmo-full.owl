    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000181"/>
        <obo:IAO_0000115>A method for determining structure by measuring the change in direction or energy of scattered neutrons. Neutrons are scattered by the atomic nuclei in the sample and phase is conserved.</obo:IAO_0000115>
