        <owl:annotatedTarget>An electrochemical analysis in which the total Coulombs of electricity required to complete (fully oxidise or fully reduce the sample in) an electrochemical reaction is measured.</owl:annotatedTarget>
        <prov:hadPrimarySource rdf:resource="https://doi.org/10.1351/goldbook.09159"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000012"/>
        <obo:IAO_0000115>An electrochemical technique where the total Coulombs of electricity required to complete (fully oxidise or fully reduce the sample in) an electrochemical reaction is measured whilst the current is held at a constant value.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>controlled current coulometry</oboInOwl:hasExactSynonym>
