    <!-- http://purl.obolibrary.org/obo/CHMO_0002594 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002594">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001543"/>
        <obo:IAO_0000115>A method of separating mixtures based on differences in their volatilities in a boiling liquid mixture under reduced pressure. As a small quantity of the sample mixture is heated using several glass bulbs connected in line, its vapours rise a short distance into a vertical condenser where they are cooled by dry ice in acetone (-78°C).</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-11-12T09:29:23Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>bulb to bulb distillation</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002594</oboInOwl:id>
        <rdfs:label>bulb-to-bulb distillation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002594"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A method of separating mixtures based on differences in their volatilities in a boiling liquid mixture under reduced pressure. As a small quantity of the sample mixture is heated using several glass bulbs connected in line, its vapours rise a short distance into a vertical condenser where they are cooled by dry ice in acetone (-78°C).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


