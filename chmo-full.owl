    <!-- http://purl.obolibrary.org/obo/CHMO_0001526 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001525"/>
        <obo:IAO_0000115>A sample dispersion &quot;in which particles of colloidal size of any nature (e.g. solid, liquid or gas) are dispersed in a continuous phase of a different composition (or state).&quot;</obo:IAO_0000115>
