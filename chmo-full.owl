        <oboInOwl:id>CHMO:0000104</oboInOwl:id>
        <rdfs:label>bright-field microscopy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000104"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Microscopy where the specimen is illuminated with light transmitted from a source on the opposite side of the specimen from the objective.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
