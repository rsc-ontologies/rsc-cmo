    <!-- http://purl.obolibrary.org/obo/CHMO_0001828 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001828">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001827"/>
