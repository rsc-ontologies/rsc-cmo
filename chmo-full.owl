        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Microscopy where the specimen is illuminated with short-coherence length visible light split into two beams, which then interfere to produce fringes whose spacing is proportional to the height of the specimen.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0824742524</oboInOwl:hasDbXref>
