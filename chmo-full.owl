    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0002725 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002725">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002724"/>
        <obo:IAO_0000115>A method for providing phasing necessary for X-ray crystallography information by growing a crystal of the sample substituted with heavy metal atoms and analysing the X-ray data for both the original crystal and the isomorph.</obo:IAO_0000115>
        <oboInOwl:created_by>Hils</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-07-26T10:46:16Z</oboInOwl:creation_date>
