    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001473">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000094"/>
        <obo:IAO_0000115>An exothermic chemical reaction between a fuel (usually a hydrocarbon) and an oxidant (usually oxygen) which is sometimes accompanied by the production of light.</obo:IAO_0000115>
