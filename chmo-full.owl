    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000042">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000041"/>
        <obo:IAO_0000115>A stripping voltammetry in which the analyte of interest is first electroplated onto the working electrode before being removed or &apos;stripped&apos; by applying an oxidising potential.</obo:IAO_0000115>
        <obo:OMO_0003012>ASV</obo:OMO_0003012>
        <oboInOwl:id>CHMO:0000042</oboInOwl:id>
        <rdfs:label>anodic stripping voltammetry</rdfs:label>
