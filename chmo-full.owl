    <!-- http://purl.obolibrary.org/obo/CHMO_0000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000010"/>
        <obo:IAO_0000115>The measurement of the conductance of a solution as a function of concentration. Measurements are made indirectly across the resistance of the solution with high-frequency alternating current (&gt;0.1 MHz).</obo:IAO_0000115>
