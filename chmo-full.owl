        <owl:annotatedTarget>WCOT</owl:annotatedTarget>
        <rdfs:comment rdf:resource="https://doi.org/10.1351/goldbook.W06654"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000973"/>
