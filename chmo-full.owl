        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001502"/>
        <obo:IAO_0000115>The repeated chemical degradation of a sample by thermal energy under the same conditions of time, temperature etc.</obo:IAO_0000115>
