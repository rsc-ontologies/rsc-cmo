    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000094"/>
        <obo:IAO_0000115>The transfer of thermal energy from a sample to its surrounding environment.</obo:IAO_0000115>
