        <oboInOwl:hasExactSynonym>electrochemical surface-enhanced Raman scattering</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>electrochemical surface-enhanced Raman spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000875</oboInOwl:id>
