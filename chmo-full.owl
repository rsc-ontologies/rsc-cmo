        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An NMR pulse sequence, employing composite pulses, which decouples nuclei i.e. removes the effects of (usually) J-coupling (line splitting) from the spectrum.</owl:annotatedTarget>
