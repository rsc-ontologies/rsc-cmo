        <owl:annotatedTarget>A solvent extraction assisted by sound waves (&gt;20 KHz in frequency) that propagate through the liquid media.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
        <prov:hadPrimarySource rdf:resource="https://doi.org/10.1351/goldbook.10231"/>
    </owl:Axiom>
    <owl:Axiom>
