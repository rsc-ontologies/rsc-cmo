        <obo:IAO_0000115>A method for providing phasing necessary for X-ray crystallography information by introducing heavy atoms into isomorphous crystals.</obo:IAO_0000115>
        <oboInOwl:created_by>Hils</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-07-26T08:14:38Z</oboInOwl:creation_date>
        <oboInOwl:id>CHMO:0002724</oboInOwl:id>
