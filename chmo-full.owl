    <!-- http://purl.obolibrary.org/obo/CHMO_0002331 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000800"/>
        <obo:IAO_0000115>A plot of current (or a first or higher derivative of current with respect to voltage) vs. voltage obtained by measuring the tunnelling current through a metal-oxide-metal sandwich. Molecules are adsorbed onto the oxide and these molecules can affect the tunnelling via the excitation of vibrational states.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
