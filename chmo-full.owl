    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000106"/>
        <obo:IAO_0000115>Microscopy where the specimen is illuminated with polarised visible light split into two beams, which then interfere to produce fringes whose spacing is proportional to the height of the specimen.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>DIC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>DIC microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>NIC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>NIC microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Nomarski interference contrast microscopy</oboInOwl:hasExactSynonym>
