information_encoding
&gt;data_encoding
&gt;&gt;image_encoding</obo:IAO_0000232>
        <rdfs:label xml:lang="en">data visualization</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0200166 -->

