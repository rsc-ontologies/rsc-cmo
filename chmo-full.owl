        <oboInOwl:hasExactSynonym>XRM</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002312</oboInOwl:id>
        <rdfs:label>X-ray microscopy</rdfs:label>
    </owl:Class>
