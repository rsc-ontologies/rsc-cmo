    <!-- http://purl.obolibrary.org/obo/CHMO_0002079 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002079">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002080"/>
        <obo:IAO_0000115>The measurement of thermodynamic parameters (e.g. enthalpy) during a chemical or biochemical reaction by the known variation (step-wise or linear) of the temperature, whilst the pressure is kept constant. Scanning rates on the order of a few mK min-1 are used and a constant power is continuously applied to (or extracted from) the sample.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-07-02T03:39:03Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>ASC</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002079</oboInOwl:id>
        <rdfs:label>adiabatic scanning calorimetry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002079"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The measurement of thermodynamic parameters (e.g. enthalpy) during a chemical or biochemical reaction by the known variation (step-wise or linear) of the temperature, whilst the pressure is kept constant. Scanning rates on the order of a few mK min-1 are used and a constant power is continuously applied to (or extracted from) the sample.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1021/jf0110396</oboInOwl:hasDbXref>
    </owl:Axiom>
    


