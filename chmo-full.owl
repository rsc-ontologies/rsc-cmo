    <!-- http://purl.obolibrary.org/obo/CHMO_0000754 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000754">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000753"/>
