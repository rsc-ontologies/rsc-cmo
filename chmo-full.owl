    <!-- http://purl.obolibrary.org/obo/CHMO_0002114 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002114">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001543"/>
        <obo:IAO_0000115>A method of separating mixtures based on differences in their volatilities in a boiling liquid mixture. As the sample mixture to be purified is heated, its vapours rise a short distance into a vertical condenser (called a &apos;Kugelrohr&apos;) where they are cooled by water. This technique is used for small amounts of samples with high boiling points (usually &gt;300 °C) under greatly reduced pressure.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-07-06T01:47:30Z</oboInOwl:creation_date>
        <oboInOwl:id>CHMO:0002114</oboInOwl:id>
        <rdfs:label>Kugelrohr distillation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002114"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A method of separating mixtures based on differences in their volatilities in a boiling liquid mixture. As the sample mixture to be purified is heated, its vapours rise a short distance into a vertical condenser (called a &apos;Kugelrohr&apos;) where they are cooled by water. This technique is used for small amounts of samples with high boiling points (usually &gt;300 °C) under greatly reduced pressure.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


