        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An electrochemical technique where the time dependence of the cell current is measured whilst the potential difference between the indicator and reference electrodes is controlled. Measurements are taken every 1 to 5 s.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1373/49.10.1763</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000005"/>
        <obo:IAO_0000115>An electrochemical technique where the time dependence of the cell current is measured whilst the potential difference between the indicator and reference electrodes is varied as a step function.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>potential step chronoamperometry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000007</oboInOwl:id>
