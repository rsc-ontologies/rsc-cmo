    <!-- http://purl.obolibrary.org/obo/CHEBI_33252 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_36342"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24636"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A nucleus is the positively charged central portion of an atom, excluding the orbital electrons.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Some people may be uncomfortable calling every proton an atomic nucleus</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">This is equivalent to CHEBI:33252</obo:IAO_0000116>
        <rdfs:label>atomic nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_33418 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_33418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_23367"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59999"/>
        <obo:IAO_0000115>An allotropic form of the element carbon consisting of layers of hexagonally arranged carbon atoms in a planar condensed ring system (graphene layers). The layers are stacked parallel to each other in a three-dimensional crystalline long-range order. There are two allotropic forms with different stacking arrangements, hexagonal and rhombohedral. The chemical bonds within the layers are covalent with sp&lt;small&gt;&lt;sup&gt;2&lt;/small&gt;&lt;/sup&gt; hybridization and with a C—C distance of 141.7 pm. The weak bonds between the layers are metallic with a strength comparable to van der Waals bonding only.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>cas:12751-41-6</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>cas:7782-42-5</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>gmelin:22250</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>graphite</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Cn</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Graphit</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>black lead</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>grafito</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>graphite</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>mineral carbon</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>plumbago</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:33418</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
