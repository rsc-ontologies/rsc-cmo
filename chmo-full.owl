    <!-- http://purl.obolibrary.org/obo/CHMO_0000726 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000726">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000563"/>
        <obo:IAO_0000115>Mass spectrometry where the sample (which is held in a liquid matrix) is bombarded with a stream of primary noble gas atoms and the secondary ions ejected from the sample are detected. The &apos;exact&apos; mass of these secondary is then determined, as opposed to the &apos;nominal&apos; mass (the number of protons and neutrons).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>HR FAB-MS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>HRFABMS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>high resolution FAB mass spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>high resolution fast-atom bombardment mass spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000726</oboInOwl:id>
        <rdfs:label>high resolution fast-atom bombardment mass spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000726"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Mass spectrometry where the sample (which is held in a liquid matrix) is bombarded with a stream of primary noble gas atoms and the secondary ions ejected from the sample are detected. The &apos;exact&apos; mass of these secondary is then determined, as opposed to the &apos;nominal&apos; mass (the number of protons and neutrons).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


