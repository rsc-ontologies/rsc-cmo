    <!-- http://purl.obolibrary.org/obo/CHMO_0002911 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002911">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000035"/>
