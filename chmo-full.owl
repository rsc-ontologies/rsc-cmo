    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000945 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000968"/>
