    <!-- http://purl.obolibrary.org/obo/CHMO_0001040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001040">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001019"/>
