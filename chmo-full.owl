        <oboInOwl:hasExactSynonym>SSM</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>close space sublimation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>close-space sublimation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sandwich sublimation method</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sandwich sublimation technique</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sandwich-sublimation method</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sublimation sandwich method</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sublimation-sandwich method</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002223</oboInOwl:id>
        <rdfs:label>sandwich sublimation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002223"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A technique for growing thick (micrometre) epitaxial layers of SiC by heating a source (polycrystalline SiC or powder) at high temperature (1800-2600 °C) and low pressure in an Ar atmosphere causing it to sublime. The vapours then condense on a single crystal of SiC (the &apos;seed&apos;) placed a few mm away.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


