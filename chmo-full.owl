    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002841">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000115>A process that involves adjusting a planned process in some respect. This may either be to adjust a parameter not fully specified in the plan or to adjust a parameter that was already specified in the plan.</obo:IAO_0000115>
