        <oboInOwl:hasExactSynonym>neutron scattering spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000181</oboInOwl:id>
        <rdfs:label>neutron scattering</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000181"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
