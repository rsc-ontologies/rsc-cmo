        <oboInOwl:hasExactSynonym>infrared near-field scanning optical microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000122</oboInOwl:id>
        <rdfs:label>infrared scanning near-field optical microscopy</rdfs:label>
