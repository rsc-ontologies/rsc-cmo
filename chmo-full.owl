    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000929">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000909"/>
        <obo:IAO_0000115>A magic angle spinning NMR dipolar recoupling technique used to determine dipolar couplings between 1H and 13C nuclei. A FSLG sequence is used to remove homonuclear couplings (by spin-locking the 1H nuclei) and polarization transfer from the protons to the 13C via dipolar coupling manifests as a splitting of the detected 13C signal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>FSLG-CP</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>frequency switched Lee-Goldberg cross polarisation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>frequency switched Lee-Goldberg cross polarization</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>frequency-switched Lee-Goldberg cross polarisation</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000929</oboInOwl:id>
        <rdfs:label>frequency-switched Lee-Goldberg cross polarization</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000929"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A magic angle spinning NMR dipolar recoupling technique used to determine dipolar couplings between 1H and 13C nuclei. A FSLG sequence is used to remove homonuclear couplings (by spin-locking the 1H nuclei) and polarization transfer from the protons to the 13C via dipolar coupling manifests as a splitting of the detected 13C signal.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>rsc:pr</oboInOwl:hasDbXref>
    </owl:Axiom>
    


