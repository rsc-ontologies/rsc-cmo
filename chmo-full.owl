        <oboInOwl:id>CHMO:0002597</oboInOwl:id>
        <rdfs:label>negative-staining transmission electron microscopy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002597"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Microscopy where an electron-transparent specimen, that has been stained with heavy metals salts (e.g. uranyl acetate), is bombarded with a finely focused (&lt;10 nm diameter) electron beam with an acceleration voltage 50–150 kV under vacuum and the intensities of the transmitted electrons are measured.</owl:annotatedTarget>
