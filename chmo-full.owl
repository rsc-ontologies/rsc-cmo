    <!-- http://purl.obolibrary.org/obo/CHMO_0000771 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000087"/>
        <obo:IAO_0000115>Microscopy where fluorophores in the specimen can be made to fluoresce (emit energy as visible light) by absorption of two or more photons.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>multi-photon excitation microscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>multi-photon fluorescence imaging</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>multi-photon fluorescence microscopy</oboInOwl:hasExactSynonym>
