        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001088"/>
        <obo:IAO_0000115>An electron microscope in which the image is produced by scanning the electron beam across the specimen.</obo:IAO_0000115>
        <obo:OMO_0003012>SEM</obo:OMO_0003012>
        <oboInOwl:id>CHMO:0000941</oboInOwl:id>
        <rdfs:label>scanning electron microscope</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000941"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An electron microscope in which the image is produced by scanning the electron beam across the specimen.</owl:annotatedTarget>
        <prov:wasInfluencedBy rdf:resource="https://doi.org/10.1351/goldbook.S05484"/>
