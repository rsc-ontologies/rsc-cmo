    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001087"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of electron microscopy where the distribution of electrons emitted by a specimen sample following excitation with an X-ray source is used to produce an image.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001088 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001088">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000953"/>
        <obo:IAO_0000115>A piece of apparatus which is used to produce an enlarged image of a specimen using a finely focused (&lt;10 nm diameter) electron beam with an acceleration voltage of 50–150 kV under vacuum and measuring the interaction of the electrons with the specimen.</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0001088</oboInOwl:id>
        <rdfs:label>electron microscope</rdfs:label>
    </owl:Class>
    <owl:Axiom>
