        <oboInOwl:hasExactSynonym>high-angle annular dark-field scanning transmission electron micrograph</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002619</oboInOwl:id>
        <rdfs:label>high-angular annular dark-field scanning transmission electron micrograph</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002619"/>
