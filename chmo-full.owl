    <!-- http://purl.obolibrary.org/obo/CHMO_0000519 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000519">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000515"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002202"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Mass spectrometry where the sample (usually a large organic molecule or biomolecule) is vaporised and ionised using a high-energy pulsed laser. The sample is held in a matrix (such as crystallised dihydrobenzoic acid) to protect it from direct laser illumination and to separate the sample molecules.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>FIX:0000001</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>MALDI MS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MALDI-MS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MALDIMS</oboInOwl:hasExactSynonym>
