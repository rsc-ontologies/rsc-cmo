    <!-- http://purl.obolibrary.org/obo/CHMO_0001612 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001577"/>
        <obo:IAO_0000115>An extraction &quot;in which the amount of reagent used is lower than that dictated by stoichiometry.&quot;</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0001612</oboInOwl:id>
        <rdfs:label>substoichiometric extraction</rdfs:label>
    </owl:Class>
