    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000624">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000228"/>
        <obo:IAO_0000115>Spectroscopy where the resonant excitation of surface plasmons (usually on a noble metal e.g. Au or Ag surface) by ultraviolet or visible light is measured. The light source is incident on the noble metal surface through a prism, at a range of angles that are above the critical angle where total internal reflection occurs. At a certain angle excitation of the surface plasmons occurs, leading to a minimum in the reflected light. The resonance angle shifts whenever the optical density of the sample in contact with the noble metal undergoes a change, and thus it allows detection of the adsorption or desorption of molecules.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>FIX:0000393</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>SPR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SPR spectrometry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SPR spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SPRS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>surface plasmon resonance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>surface plasmon resonance (SPR) spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>surface plasmon resonance spectrometry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000624</oboInOwl:id>
        <rdfs:label>surface plasmon resonance spectroscopy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000624"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Spectroscopy where the resonant excitation of surface plasmons (usually on a noble metal e.g. Au or Ag surface) by ultraviolet or visible light is measured. The light source is incident on the noble metal surface through a prism, at a range of angles that are above the critical angle where total internal reflection occurs. At a certain angle excitation of the surface plasmons occurs, leading to a minimum in the reflected light. The resonance angle shifts whenever the optical density of the sample in contact with the noble metal undergoes a change, and thus it allows detection of the adsorption or desorption of molecules.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1039/b9nr00156e</oboInOwl:hasDbXref>
    </owl:Axiom>
    


