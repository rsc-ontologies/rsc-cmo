    <!-- http://purl.obolibrary.org/obo/CHMO_0000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000024"/>
        <obo:IAO_0000115>An electrochemical technique where the cell current is measured as a function of time and as a function of the potential between the indicator and reference electrodes. The potential is varied using pulses of increasing amplitude.</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0000029</oboInOwl:id>
        <rdfs:label>pulse voltammetry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000029"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An electrochemical technique where the cell current is measured as a function of time and as a function of the potential between the indicator and reference electrodes. The potential is varied using pulses of increasing amplitude.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000030 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000030">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000029"/>
