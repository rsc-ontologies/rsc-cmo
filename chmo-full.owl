    <!-- http://purl.obolibrary.org/obo/CHMO_0002215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002214"/>
        <obo:IAO_0000115>A technique for preparing a polymer membrane by mixing polymer and solvent, then casting this solution onto a surface and allowing the solvent to partially evaporate. The film is them immersed in a nonsolvent causing solidification.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-07-28T01:21:07Z</oboInOwl:creation_date>
