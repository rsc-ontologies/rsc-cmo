    <!-- http://purl.obolibrary.org/obo/CHMO_0002933 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000016"/>
        <obo:IAO_0000112 xml:lang="en">As an electrochemical technique for measuring and characterizing batteries and E-chem cells.</obo:IAO_0000112>
        <obo:IAO_0000115 xml:lang="en">A potentiometry where the potential difference between two electrodes (typically a working and a reference electrode) is measured under open circuit conditions, ensuring that no significant current flows and the system remains in thermodynamic equilibrium. The measured characteristic is the Open Circuit Voltage (OCV) also called Open Circuit Potential (OCP).</obo:IAO_0000115>
        <obo:IAO_0000233 rdf:resource="https://github.com/rsc-ontologies/rsc-cmo/issues/35"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-1595-3213"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-4378-6061"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0009-0008-1636-0875"/>
        <oboInOwl:hasExactSynonym xml:lang="en">OCP measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OCV measurement</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym xml:lang="en">OCV potentiometry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>OCP</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>OCV</oboInOwl:hasNarrowSynonym>
        <oboInOwl:id>CHMO:0002933</oboInOwl:id>
        <rdfs:label xml:lang="en">open circuit voltage potentiometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002933"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget xml:lang="en">A potentiometry where the potential difference between two electrodes (typically a working and a reference electrode) is measured under open circuit conditions, ensuring that no significant current flows and the system remains in thermodynamic equilibrium. The measured characteristic is the Open Circuit Voltage (OCV) also called Open Circuit Potential (OCP).</owl:annotatedTarget>
        <dcterms:source>https://doi.org/10.1016/j.jpowsour.2014.06.152</dcterms:source>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0002934 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002934">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
