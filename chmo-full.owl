    <!-- http://purl.obolibrary.org/obo/CHMO_0002284 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002284">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000762"/>
        <obo:IAO_0000115>Spectroscopy where the spontaneous fluorescence intensity fluctuations of a sample are measured and correlated within a very small detection volume which is moving with respect to the sample. The temporal and spatial correlation between adjacent pixels, lines and frames is calculated allowing for the mapping of local translational diffusion coefficients.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-08-20T03:35:34Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>RICS</oboInOwl:hasExactSynonym>
