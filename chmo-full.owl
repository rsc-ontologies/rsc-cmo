    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002294">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001632"/>
        <obo:IAO_0000115>A technique for separating magnetic and nonmagentic particles by placing the sample in a narrow channel and applying a magnetic field. Magnetic particles are dragged away from their stream into a separate buffer stream, leaving the nonmagnetic particles behind.</obo:IAO_0000115>
