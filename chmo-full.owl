    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001998">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001835"/>
        <obo:IAO_0000115>A type of column chromatography where the mobile phase is a liquid, the stationary phase consists of very small particles and the inlet pressure is relatively high. An initial separation proceeds in a primary ion-exchange column (the particles of which shows no loss or gain of charge with varying pH) and parts of the eluent from this column are directed into a secondary column where the stationary phase is significantly less polar than the mobile phase.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-06-19T11:05:17Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>SCX-RP HPLC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SCX-RP-HPLC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>strong cation exchange  reverse phase  high performance liquid chromatography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>strong-cation-exchang reversed-phase HPLC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>strong-cation-exchang reversed-phase high-pressure liquid chromatography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>strong-cation-exchange reverse-phase HPLC</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>strong-cation-exchange reversed phase high-performance liquid chromatography</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>strong-cation-exchange reversed-phase high pressure liquid chromatography</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001998</oboInOwl:id>
        <rdfs:label>strong-cation-exchange reversed-phase high-performance liquid chromatography</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001998"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type of column chromatography where the mobile phase is a liquid, the stationary phase consists of very small particles and the inlet pressure is relatively high. An initial separation proceeds in a primary ion-exchange column (the particles of which shows no loss or gain of charge with varying pH) and parts of the eluent from this column are directed into a secondary column where the stationary phase is significantly less polar than the mobile phase.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


