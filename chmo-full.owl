        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000330"/>
        <obo:IAO_0000115>A technique for measuring the time-resolved concentration of radicals during polymerisation reactions. The polymerisation is initiated by a single pulse of laser radiation and the radical concentration is monitored by measuring response of the unpaired electrons to short (ns) pulses of microwave radiation in a magnetic field.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-03-13T11:45:02Z</oboInOwl:creation_date>
