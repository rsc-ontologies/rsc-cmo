        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001626 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001626">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001625"/>
        <obo:IAO_0000115>A fractionation based on the application of a field perpendicular to a flow stream in a narrow channel.</obo:IAO_0000115>
        <obo:OMO_0003012>FFF</obo:OMO_0003012>
        <oboInOwl:hasExactSynonym>field flow fractionation</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001626</oboInOwl:id>
        <rdfs:label>field-flow fractionation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001626"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
