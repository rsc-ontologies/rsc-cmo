    <!-- http://purl.obolibrary.org/obo/CHMO_0000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000024"/>
        <obo:IAO_0000115>A &quot;voltammetry in which [...] the potential is varied linearly&quot; and stops at an end point.</obo:IAO_0000115>
        <obo:OMO_0003012>LSV</obo:OMO_0003012>
        <oboInOwl:hasExactSynonym>chrono amperometry with linear potenial sweep</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>chronoamperometry with linear sweep</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>electrode voltammetry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>linear sweep voltammetry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>linear-scan voltammetry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>stationary electrode voltammetry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000028</oboInOwl:id>
        <rdfs:label>linear-sweep voltammetry</rdfs:label>
