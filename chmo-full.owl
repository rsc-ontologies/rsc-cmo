            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A piece of apparatus that contains a reagent gas that reacts preferentially with certain species in order to allow only the analyte ions into the mass-to-charge analyser and the detector.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>DRC</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000945</oboInOwl:id>
