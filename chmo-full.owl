        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A method for determining structure by measuring the change in direction or energy of neutrons scattered at low angles. The incident neutron beam strikes the sample under a small angle close to the critical angle of total external neutron reflection.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


