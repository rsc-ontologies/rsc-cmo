    <!-- http://purl.obolibrary.org/obo/CHMO_0000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000003"/>
        <obo:IAO_0000115>An electrochemical analysis in which the total Coulombs of electricity required to complete (fully oxidise or fully reduce the sample in) an electrochemical reaction is measured.</obo:IAO_0000115>
