        <oboInOwl:hasExactSynonym>ytterbium-89 cross-polarisation magic angle spinning</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002492</oboInOwl:id>
        <rdfs:label>89Y cross-polarisation magic angle spinning</rdfs:label>
