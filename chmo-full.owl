    <!-- http://purl.obolibrary.org/obo/CHMO_0000974 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000974">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000997"/>
        <obo:IAO_0000115>A chromatography column &quot;in which either the inner tube wall, or a liquid or active solid held stationary on the tube wall acts as the stationary phase and there is an open, unrestricted path for the mobile phase.&quot;</obo:IAO_0000115>
