        <oboInOwl:hasExactSynonym>195Pt-NMR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>platinum-195 NMR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>platinum-195 nuclear magnetic resonance spectroscopy</oboInOwl:hasExactSynonym>
