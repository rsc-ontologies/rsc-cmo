        <oboInOwl:hasExactSynonym>ion-pairing chromatography</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002280</oboInOwl:id>
        <rdfs:label>ion-pair chromatography</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002280"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A column chromatography in which ions in solution can be &apos;paired&apos; or neutralised and separated as an ion pair on a reversed-phase column. Ion-pairing agents are usually ionic compounds that contain a hydrocarbon chain.</owl:annotatedTarget>
