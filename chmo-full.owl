    <!-- http://purl.obolibrary.org/obo/CHMO_0001843 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001843">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001841"/>
        <obo:IAO_0000115>A pulse cluster (a spin echo on 1H with inversion of 13C in the centre) used to achieve selective inversion of 12C-bound protons, thus achieving the removal of signals due to 12C-bound nuclei. For the pulse sequence see Chem. Phys. Lett., (1982), 93, pg 504</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-05-29T12:00:00Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>BIRD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>bilinear rotation decoupling</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001843</oboInOwl:id>
        <rdfs:label>bilinear rotation decoupling pulse sequence</rdfs:label>
    </owl:Class>
