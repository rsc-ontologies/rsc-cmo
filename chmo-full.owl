    <!-- http://purl.obolibrary.org/obo/CHMO_0000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000005"/>
        <obo:IAO_0000115>An electrochemical technique where the time dependence of the cell current is measured whilst the potential difference between the indicator and reference electrodes is controlled. Measurements are taken every 1 to 5 s.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>high-speed chronoamperometry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000006</oboInOwl:id>
