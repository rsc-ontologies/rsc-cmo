    <!-- http://purl.obolibrary.org/obo/CHMO_0002720 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002720">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001711"/>
        <obo:IAO_0000115>A detection method that is sensitive to individual elements. The sample is both atomised and excited by a microwave-induced plasma (a partially ionised gas containing free electrons and radicals). The characteristic radiation emitted by the atoms in the sample is then detected using a photodiode array.</obo:IAO_0000115>
        <oboInOwl:created_by>Hils</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-07-25T05:39:50Z</oboInOwl:creation_date>
        <oboInOwl:hasDbXref>FIX:0000925</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>MIP-AED</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>MIP/AED</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>microwave-induced plasma atomic emission detection</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0002720</oboInOwl:id>
        <rdfs:label>microwave induced plasma atomic emission detection</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002720"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A detection method that is sensitive to individual elements. The sample is both atomised and excited by a microwave-induced plasma (a partially ionised gas containing free electrons and radicals). The characteristic radiation emitted by the atoms in the sample is then detected using a photodiode array.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


