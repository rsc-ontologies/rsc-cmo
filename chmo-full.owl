        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001496"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The assisted solubilisation of a sample by the application of radiation in the 1-1000 mm region.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001497 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001497">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001489"/>
        <obo:IAO_0000115>The decomposition of a sample by placing it in an organic matrix and irradiating the matrix with radiation in the range 200-435 nm (indirectly, using a mirror). OH radicals generated from the matrix react with the sample, degrading it.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>UV photolysis digestion</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>UVPD</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001497</oboInOwl:id>
        <rdfs:label>ultraviolet photolysis digestion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001497"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The decomposition of a sample by placing it in an organic matrix and irradiating the matrix with radiation in the range 200-435 nm (indirectly, using a mirror). OH radicals generated from the matrix react with the sample, degrading it.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1016/S0021-9673(02)01335-3</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001498 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001498">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001487"/>
        <obo:IAO_0000115>A decomposition &quot;in which the enzyme converts a high molecular mass compound into lower molecular mass species.&quot;</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0001498</oboInOwl:id>
        <rdfs:label>enzymic decomposition</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001498"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A decomposition &quot;in which the enzyme converts a high molecular mass compound into lower molecular mass species.&quot;</owl:annotatedTarget>
        <dcterms:bibliographicCitation>&apos;enzymic decomposition&apos; in IUPAC Compendium of Chemical Terminology, 5th ed. International Union of Pure and Applied Chemistry; 2025. Online version 5.0.0, 2025. https://doi.org/10.1351/goldbook.E02162</dcterms:bibliographicCitation>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
        <dcterms:rightsHolder rdf:resource="https://ror.org/03ne2zw20"/>
        <dcterms:source rdf:resource="https://doi.org/10.1351/goldbook.E02162"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001499 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001499">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001487"/>
        <obo:IAO_0000115>A  decomposition consisiting of &quot;a clustering reaction in a homogeneous, supersaturated solution (solid or liquid) which is unstable against infinitesimal fluctuations in density or composition. The solution therefore separates spontaneously into two phases, starting with small fluctuations and proceeding with a decrease in the Gibbs energy without a nucleation barrier.&quot;</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0001499</oboInOwl:id>
        <rdfs:label>spinodal decomposition</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001499"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A  decomposition consisiting of &quot;a clustering reaction in a homogeneous, supersaturated solution (solid or liquid) which is unstable against infinitesimal fluctuations in density or composition. The solution therefore separates spontaneously into two phases, starting with small fluctuations and proceeding with a decrease in the Gibbs energy without a nucleation barrier.&quot;</owl:annotatedTarget>
        <dcterms:bibliographicCitation>&apos;spinodal decomposition&apos; in IUPAC Compendium of Chemical Terminology, 5th ed. International Union of Pure and Applied Chemistry; 2025. Online version 5.0.0, 2025. https://doi.org/10.1351/goldbook.S05869</dcterms:bibliographicCitation>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
        <dcterms:rightsHolder rdf:resource="https://ror.org/03ne2zw20"/>
        <dcterms:source rdf:resource="https://doi.org/10.1351/goldbook.S05869"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001500 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001487"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002770"/>
        <obo:IAO_0000115>The separation of a chemical compound into elements or smaller compounds by heating it to a high temperature (approx. 1000 °C).</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0001500</oboInOwl:id>
        <rdfs:label>thermal decomposition</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001500"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The separation of a chemical compound into elements or smaller compounds by heating it to a high temperature (approx. 1000 °C).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001501 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001500"/>
        <obo:IAO_0000115>The conversion of carbonaceous materials (e.g. such as coal, petroleum, biofuel, or biomass) into CO and H2 by heating with a controlled amount of oxygen and/or steam. The resulting gas mixture is called a &apos;syngas&apos;.</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0001501</oboInOwl:id>
        <rdfs:label>gasification</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001501"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The conversion of carbonaceous materials (e.g. such as coal, petroleum, biofuel, or biomass) into CO and H2 by heating with a controlled amount of oxygen and/or steam. The resulting gas mixture is called a &apos;syngas&apos;.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001502 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001500"/>
        <obo:IAO_0000115>A thermal decomposition in which the chemical degradation of a sample by thermal energy takes place. The term pyrolysis generally refers to heating in an inert environment.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>destructive distillation</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>dry distillation</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001502</oboInOwl:id>
        <rdfs:label>pyrolysis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001502"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A thermal decomposition in which the chemical degradation of a sample by thermal energy takes place. The term pyrolysis generally refers to heating in an inert environment.</owl:annotatedTarget>
        <prov:hadPrimarySource rdf:resource="https://doi.org/10.1351/goldbook.P04961"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001503 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001503">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001502"/>
        <obo:IAO_0000115>A pyrolysis in which &quot;the characterisation, in an inert atmosphere, of a material or a chemical process by a chemical degradation reaction(s) induced by thermal energy&quot; takes place.</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0001503</oboInOwl:id>
        <rdfs:label>analytical pyrolysis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001503"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pyrolysis in which &quot;the characterisation, in an inert atmosphere, of a material or a chemical process by a chemical degradation reaction(s) induced by thermal energy&quot; takes place.</owl:annotatedTarget>
        <dcterms:bibliographicCitation>&apos;analytical pyrolysis&apos; in IUPAC Compendium of Chemical Terminology, 5th ed. International Union of Pure and Applied Chemistry; 2025. Online version 5.0.0, 2025. https://doi.org/10.1351/goldbook.A00336</dcterms:bibliographicCitation>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by-sa/4.0/"/>
        <dcterms:rightsHolder rdf:resource="https://ror.org/03ne2zw20"/>
        <dcterms:source rdf:resource="https://doi.org/10.1351/goldbook.A00336"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001504 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001502"/>
        <obo:IAO_0000115>The chemical degradation of a sample by thermal energy in the presence of a catalyst.</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0001504</oboInOwl:id>
        <rdfs:label>catalytic pyrolysis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001504"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The chemical degradation of a sample by thermal energy in the presence of a catalyst.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>OrangeBook:5.3</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001505 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001505">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001502"/>
        <obo:IAO_0000115>The chemical degradation of a sample caused by a fast rate of temperature increase (10,000 K/s).</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0001505</oboInOwl:id>
        <rdfs:label>flash pyrolysis</rdfs:label>
    </owl:Class>
