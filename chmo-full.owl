        <oboInOwl:hasExactSynonym>sorption-desorption</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>sorption/desorption</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001167</oboInOwl:id>
        <rdfs:label>sorption-desorption measurement</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001167"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
