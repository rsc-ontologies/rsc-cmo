    <!-- http://purl.obolibrary.org/obo/CHMO_0001601 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001601">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001600"/>
        <obo:IAO_0000115>A liquid-liquid extraction in which a non-ionic surfactant is transferred from one liquid phase to another by heating. As the temperature of the solution rises, the surfactant molecules form micelles, if the temperature increases above the cloud point (CPT) the micelles become dehydrated and aggregate. This leads to macroscopic phase separation of the solution into a surfactant-rich phase and a solvent phase.</obo:IAO_0000115>
        <obo:OMO_0003012>CPE</obo:OMO_0003012>
        <oboInOwl:hasExactSynonym>cloud point extraction</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001601</oboInOwl:id>
        <rdfs:label>cloud-point extraction</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001601"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A liquid-liquid extraction in which a non-ionic surfactant is transferred from one liquid phase to another by heating. As the temperature of the solution rises, the surfactant molecules form micelles, if the temperature increases above the cloud point (CPT) the micelles become dehydrated and aggregate. This leads to macroscopic phase separation of the solution into a surfactant-rich phase and a solvent phase.</owl:annotatedTarget>
        <prov:hadPrimarySource rdf:resource="https://doi.org/10.1039/b901007f"/>
        <prov:wasInfluencedBy rdf:resource="https://doi.org/10.1351/goldbook.10207"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001601"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
        <owl:annotatedTarget>CPE</owl:annotatedTarget>
        <dcterms:source rdf:resource="https://doi.org/10.1039/b901007f"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001601"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>cloud point extraction</owl:annotatedTarget>
        <dcterms:source rdf:resource="https://doi.org/10.1351/goldbook.10207"/>
    </owl:Axiom>
    


