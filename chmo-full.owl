        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000800"/>
        <obo:IAO_0000115>A plot of reflectance (%) vs. wavenumber obtained by measuring the amount of radiation reflected by a sample.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>reflectance spectra</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000937</oboInOwl:id>
        <rdfs:label>reflectance spectrum</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000937"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A plot of reflectance (%) vs. wavenumber obtained by measuring the amount of radiation reflected by a sample.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1021/j100173a016</oboInOwl:hasDbXref>
    </owl:Axiom>
    


