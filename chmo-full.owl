        <oboInOwl:id>CHMO:0002470</oboInOwl:id>
        <rdfs:label>bright-field transmission electron microscopy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002470"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Microscopy where an electron-transparent specimen is bombarded with a finely focused (&lt;10 nm diameter) electron beam with an acceleration voltage 50–150 kV. under vacuum. The beam of electrons passes directly through an aperture before reaching the specimen. The image results from a weakening of the direct beam by its interaction with the sample.</owl:annotatedTarget>
