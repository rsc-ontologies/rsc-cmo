        <owl:annotatedTarget>An NMR experiment where pulsed field gradients are used to filter thermal signals from NMR spectra whilst leaving those derived from para-hydrogen-derived protons intact.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/b616307f</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001179">
