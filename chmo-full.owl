    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0002275"/>
        <obo:IAO_0000115>A separation method where protein molecules move at different speeds, in non-denaturing conditions, according to their charge and frictional forces in a separation medium consisting of polyacrylamide gel, across which an electric field is applied. The dye Coomassie blue is used to transfer charge to the protein.</obo:IAO_0000115>
