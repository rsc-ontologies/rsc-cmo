    <!-- http://purl.obolibrary.org/obo/CHMO_0002470 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002470">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000080"/>
        <obo:IAO_0000115>Microscopy where an electron-transparent specimen is bombarded with a finely focused (&lt;10 nm diameter) electron beam with an acceleration voltage 50–150 kV. under vacuum. The beam of electrons passes directly through an aperture before reaching the specimen. The image results from a weakening of the direct beam by its interaction with the sample.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-09-29T06:15:27Z</oboInOwl:creation_date>
        <oboInOwl:hasExactSynonym>BF-TEM</oboInOwl:hasExactSynonym>
