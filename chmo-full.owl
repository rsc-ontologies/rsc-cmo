        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000212"/>
        <obo:IAO_0000115>A method for determining structure by directing an optical pulse through an optical fibre and measuring the intensity of light reflected at the Brewster angle as a function of time.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>OTDR</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>optical time domain reflectivity</oboInOwl:hasExactSynonym>
