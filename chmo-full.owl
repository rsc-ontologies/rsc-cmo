    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001517 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001517">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001502"/>
