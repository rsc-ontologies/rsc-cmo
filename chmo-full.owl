        <obo:IAO_0000115 xml:lang="en">An image creation device is a device which captures a digitized image of an object</obo:IAO_0000115>
        <obo:IAO_0000117>Frank Gibson</obo:IAO_0000117>
        <obo:IAO_0000118>image acquisition device</obo:IAO_0000118>
