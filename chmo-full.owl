    <!-- http://purl.obolibrary.org/obo/CHMO_0000105 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000105">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000102"/>
        <obo:IAO_0000115>Microscopy where two specimens can be compared by illuminating them with visible light using two identical sets of microscope lenses which are linked by an optical bridge.</obo:IAO_0000115>
        <oboInOwl:id>CHMO:0000105</oboInOwl:id>
        <rdfs:label>comparison light microscopy</rdfs:label>
