        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000025"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A voltammetry in which the potential is varied linearly and inverts at the end point resulting in a cycle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FIX:0000099</oboInOwl:hasDbXref>
        <prov:hadPrimarySource rdf:resource="https://doi.org/10.1351/goldbook.09134"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000025"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/OMO_0003012"/>
        <owl:annotatedTarget>CV</owl:annotatedTarget>
        <dcterms:source rdf:resource="https://doi.org/10.1351/goldbook.09134"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000025"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>cyclic linear scan voltammetry</owl:annotatedTarget>
        <dcterms:source rdf:resource="https://doi.org/10.1351/goldbook.09134"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000025"/>
        <obo:IAO_0000115>An electrochemical technique where the cell current is measured as a function of time and as a function of the potential between the indicator and reference electrodes. The potential is varied linearly and inverts at the end point resulting in a cycle which repeats approximately every 100 ms.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>FCV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>FSCV</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fast cyclic voltammetry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>fast scan cyclic voltammetry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000026</oboInOwl:id>
        <rdfs:label>fast-scan cyclic voltammetry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000026"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An electrochemical technique where the cell current is measured as a function of time and as a function of the potential between the indicator and reference electrodes. The potential is varied linearly and inverts at the end point resulting in a cycle which repeats approximately every 100 ms.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>FIX:0000761</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://doi.org/10.1373/49.10.1763</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000024"/>
        <obo:IAO_0000115>A &quot;voltammetry with forced flow of the solution towards the electrode surface&quot;.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>linear scan hydrodynamic voltammetry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>linear-scan hydrodynamic voltammetry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000027</oboInOwl:id>
        <rdfs:label>hydrodynamic voltammetry</rdfs:label>
    </owl:Class>
