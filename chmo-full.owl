        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000004"/>
        <obo:IAO_0000115>An electrochemical technique where the cell current is measured whilst the potential difference between the indicator and reference electrodes is held at a constant value (sufficient to oxidize or reduce the sample).</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CPA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>constant-potential amperometry</oboInOwl:hasExactSynonym>
