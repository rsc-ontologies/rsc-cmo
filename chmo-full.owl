                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000538"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A method where a sample mixture is first adsorbed onto packed tubes (e.g. Tenax) then moved into a desorption oven and heated (100–280 °C for 5–20 min) to promote thermal desorption of the mixture into the headspace of the tube. The headspace is sampled and used for gas chromatography and the eluent is then ionised and characterised according to mass-to-charge ratio and relative abundance.</obo:IAO_0000115>
        <oboInOwl:created_by>https://orcid.org/0000-0001-5985-7429</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-12-11T01:18:41Z</oboInOwl:creation_date>
