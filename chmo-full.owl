    <!-- http://purl.obolibrary.org/obo/CHMO_0002534 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000323"/>
        <obo:IAO_0000115>Spectroscopy based on the differential absorption of left- and right-handed circularly polarised light by a sample. Laser light of frequency \nu is converted to light of frequency 2\nu by a non-linear interaction with the sample, and the polarisation of this light (the &apos;second harmonic&apos;) is determined.</obo:IAO_0000115>
