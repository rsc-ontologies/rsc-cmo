        <owl:annotatedTarget>SWV</owl:annotatedTarget>
        <dcterms:source rdf:resource="https://doi.org/10.1351/goldbook.09147"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0000041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000024"/>
        <obo:IAO_0000115>A voltammerty in which the analyte of interest is first deposited (usually by electroplating) onto the working electrode before being removed or &apos;stripped&apos;. The measurement takes place during the removal.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>SV</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000041</oboInOwl:id>
        <rdfs:label>stripping voltammetry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000041"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A voltammerty in which the analyte of interest is first deposited (usually by electroplating) onto the working electrode before being removed or &apos;stripped&apos;. The measurement takes place during the removal.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://orcid.org/0000-0002-0640-0422</oboInOwl:hasDbXref>
        <prov:wasInfluencedBy rdf:resource="https://doi.org/10.1351/goldbook.09155"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000041"/>
