    <!-- http://purl.obolibrary.org/obo/CHMO_0001527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001525"/>
        <obo:IAO_0000115>A technique for the preparation and extraction of solid and viscous samples. The sample is blended with a bonded-phase solid support (such as silica) using a glass pestle to obtain a semi-dry material. The blended sample is then packed into a cartridge and eluted.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MSPD</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0001527</oboInOwl:id>
        <rdfs:label>matrix solid-phase dispersion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001527"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A technique for the preparation and extraction of solid and viscous samples. The sample is blended with a bonded-phase solid support (such as silica) using a glass pestle to obtain a semi-dry material. The blended sample is then packed into a cartridge and eluted.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>https://doi.org/10.1016/S0021-9673(99)00055-2</oboInOwl:hasDbXref>
    </owl:Axiom>
    


