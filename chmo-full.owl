        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001843"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pulse cluster (a spin echo on 1H with inversion of 13C in the centre) used to achieve selective inversion of 12C-bound protons, thus achieving the removal of signals due to 12C-bound nuclei. For the pulse sequence see Chem. Phys. Lett., (1982), 93, pg 504</owl:annotatedTarget>
        <oboInOwl:hasDbXref>rsc:pr</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHMO_0001844 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001844">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001841"/>
        <obo:IAO_0000115>An NMR pulse sequence that decouples nuclei i.e. removes the effects of (usually) J-coupling (line splitting) from the spectrum.</obo:IAO_0000115>
