        <oboInOwl:hasExactSynonym>flip-back nuclear Overhauser effect spectrometry</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>flip-back nuclear Overhauser effect spectroscopy</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>flip-back nuclear Overhauser enhancement spectrometry</oboInOwl:hasExactSynonym>
        <oboInOwl:id>CHMO:0000609</oboInOwl:id>
        <rdfs:label>flip-back nuclear Overhauser enhancement spectroscopy</rdfs:label>
    </owl:Class>
