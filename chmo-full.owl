    <!-- http://purl.obolibrary.org/obo/CHMO_0000124 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0000124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0000118"/>
        <obo:IAO_0000115>Microscopy where a laser spot is focused on a solid sharp metallic probe producing a confined light field very close to (&lt;10 nm from) the surface of the specimen. An image is produced by scanning the probe over the specimen and detecting the scattering of the incident light by the probe as a function of position. A force feedback loop is used to maintain a fixed relationship between the probe and surface during scanning.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>aNSOM</oboInOwl:hasExactSynonym>
