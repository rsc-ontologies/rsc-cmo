    <!-- http://purl.obolibrary.org/obo/CHMO_0001041 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0001041">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001035"/>
        <obo:IAO_0000115>Electrokinetic chromatography where the secondary phase has liposomes suspended in it.</obo:IAO_0000115>
