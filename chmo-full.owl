    <!-- http://purl.obolibrary.org/obo/CHMO_0002736 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHMO_0002736">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHMO_0001073"/>
