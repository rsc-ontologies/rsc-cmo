#   Classes
############################

# Class: <http://purl.obolibrary.org/obo/OBCS_0000001> (statistical data analysis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBCS_0000001> "A data transformation that has input of mulitple data and report overall trend of the data.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBCS_0000001> "statistical data analysis"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/OBCS_0000001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000417> ObjectUnionOf(<http://purl.obolibrary.org/obo/OBCS_0000124> <http://purl.obolibrary.org/obo/OBI_0200078>)))
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000001> <http://purl.obolibrary.org/obo/OBI_0200000>)

# Class: <http://purl.obolibrary.org/obo/OBCS_0000058> (sensitivity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBCS_0000058> "A data item that measures the proportion of actual positives which are correctly identified as such (e.g. the percentage of sick people who are correctly identified as having the condition).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/OBCS_0000058> "STATO:0000233")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBCS_0000058> "sensitivity")
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000058> <http://purl.obolibrary.org/obo/OBCS_0000220>)
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000058> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> <http://purl.obolibrary.org/obo/OBCS_0000214>))
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000058> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000312> <http://purl.obolibrary.org/obo/OBCS_0000121>))

# Class: <http://purl.obolibrary.org/obo/OBCS_0000059> (specificity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBCS_0000059> "A data item that refers to the proportion of negatives in a binary classification test which are correctly identified")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/OBCS_0000059> "STATO:0000134")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBCS_0000059> "specificity")
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000059> <http://purl.obolibrary.org/obo/OBCS_0000220>)
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000059> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000312> <http://purl.obolibrary.org/obo/OBCS_0000121>))

# Class: <http://purl.obolibrary.org/obo/OBCS_0000070> (confidence interval)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBCS_0000070> "A quantitative confidence value that refers to an interval give values within which there is a high probability (95 percent by convention) that the true population value can be found. The calculation of a confidence interval considers the standard deviation of the data and the number of observations. Thus, a confidence interval narrows as the number of observations increases, or its variance (dispersion) decreases.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBCS_0000070> "confidence interval")
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000070> <http://purl.obolibrary.org/obo/OBI_0000071>)

# Class: <http://purl.obolibrary.org/obo/OBCS_0000120> (data matrix)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBCS_0000120> "A data item that is more specifically a rectangular array of numbers, symbols, or expressions, arranged in rows and columns.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBCS_0000120> "data matrix")
EquivalentClasses(<http://purl.obolibrary.org/obo/OBCS_0000120> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/IAO_0000027> ObjectAllValuesFrom(<http://purl.obolibrary.org/obo/RO_0002351> <http://purl.obolibrary.org/obo/IAO_0000100>) ObjectMinCardinality(2 <http://purl.obolibrary.org/obo/RO_0002351> <http://purl.obolibrary.org/obo/IAO_0000100>)))
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000120> <http://purl.obolibrary.org/obo/IAO_0000027>)

# Class: <http://purl.obolibrary.org/obo/OBCS_0000121> (inferential statistical data analysis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBCS_0000121> "A statistical data analysis that uses patterns in the sample data to draw inferences about the population represented, accounting for randomness.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBCS_0000121> "inferential statistical data analysis"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/OBCS_0000121> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000417> <http://purl.obolibrary.org/obo/OBCS_0000124>))
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000121> <http://purl.obolibrary.org/obo/OBCS_0000001>)
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000121> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000293> <http://purl.obolibrary.org/obo/IAO_0000100>))

# Class: <http://purl.obolibrary.org/obo/OBCS_0000122> (transformed data matrix)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBCS_0000122> "A data item that consists of two or more data sets that are produced as the output of a data transformation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBCS_0000122> "transformed data matrix")
EquivalentClasses(<http://purl.obolibrary.org/obo/OBCS_0000122> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/IAO_0000027> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002351> <http://purl.obolibrary.org/obo/OBCS_0000123>) ObjectMinCardinality(2 <http://purl.obolibrary.org/obo/RO_0002351> <http://purl.obolibrary.org/obo/OBCS_0000123>)))
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000122> <http://purl.obolibrary.org/obo/IAO_0000027>)

# Class: <http://purl.obolibrary.org/obo/OBCS_0000123> (transformed data set)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBCS_0000123> "A data set that is produced as the output of a data transformation.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBCS_0000123> "transformed data set"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/OBCS_0000123> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/IAO_0000100> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000312> <http://purl.obolibrary.org/obo/OBI_0200000>)))
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000123> <http://purl.obolibrary.org/obo/IAO_0000100>)
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000123> <http://purl.obolibrary.org/obo/OBCS_0000233>)
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000123> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002351> <http://purl.obolibrary.org/obo/OBCS_0000233>))

# Class: <http://purl.obolibrary.org/obo/OBCS_0000124> (inferential statistical data analysis objective)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBCS_0000124> "A statistical data analysis objective where the aim is to make inference using population sample data. ")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBCS_0000124> "inferential statistical data analysis objective"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000124> <http://purl.obolibrary.org/obo/OBI_0200166>)

# Class: <http://purl.obolibrary.org/obo/OBCS_0000214> (sensitivity disposition)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBCS_0000214> "A disposition that inheres in a population of continuant and is realized in a test process (e.g., disease diagnosis).")
AnnotationAssertion(<http://purl.org/dc/elements/1.1/creator> <http://purl.obolibrary.org/obo/OBCS_0000214> "AB, JZ, JFE, YH")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBCS_0000214> "sensitivity disposition"@en)
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000214> <http://purl.obolibrary.org/obo/BFO_0000016>)

# Class: <http://purl.obolibrary.org/obo/OBCS_0000218> (derived data from statistical analysis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBCS_0000218> "A data item that is derived from a statistical data analysis.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBCS_0000218> "derived data from statistical analysis"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/OBCS_0000218> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/IAO_0000027> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000312> <http://purl.obolibrary.org/obo/OBCS_0000001>)))
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000218> <http://purl.obolibrary.org/obo/OBCS_0000233>)

# Class: <http://purl.obolibrary.org/obo/OBCS_0000220> (derived data from inferential statistical analysis)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/OBCS_0000220> "A data item that is derived from an inferential statistical data analysis.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/OBCS_0000220> "derived data from inferential statistical analysis"@en)
EquivalentClasses(<http://purl.obolibrary.org/obo/OBCS_0000220> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/IAO_0000027> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/OBI_0000312> <http://purl.obolibrary.org/obo/OBCS_0000121>)))
SubClassOf(<http://purl.obolibrary.org/obo/OBCS_0000220> <http://purl.obolibrary.org/obo/OBCS_0000218>)

